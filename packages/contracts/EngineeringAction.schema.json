{
  "$defs": {
    "AssetRequirement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,60}$",
          "title": "Id",
          "type": "string"
        },
        "purpose": {
          "maxLength": 400,
          "minLength": 5,
          "title": "Purpose",
          "type": "string"
        },
        "provider": {
          "default": "component_svg",
          "enum": [
            "component_svg",
            "image_service",
            "project_image"
          ],
          "title": "Provider",
          "type": "string"
        },
        "title": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/SemanticItem"
          },
          "maxItems": 8,
          "title": "Items",
          "type": "array"
        },
        "image_prompt": {
          "anyOf": [
            {
              "maxLength": 2500,
              "minLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Prompt"
        },
        "size": {
          "default": "landscape",
          "enum": [
            "landscape",
            "portrait",
            "square"
          ],
          "title": "Size",
          "type": "string"
        },
        "transparent": {
          "default": false,
          "title": "Transparent",
          "type": "boolean"
        },
        "project_asset_id": {
          "anyOf": [
            {
              "pattern": "^mat_[a-f0-9]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Asset Id"
        }
      },
      "required": [
        "id",
        "purpose",
        "provider",
        "title",
        "items",
        "image_prompt",
        "size",
        "transparent",
        "project_asset_id"
      ],
      "title": "AssetRequirement",
      "type": "object"
    },
    "SemanticItem": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "detail": {
          "default": "",
          "maxLength": 180,
          "title": "Detail",
          "type": "string"
        },
        "active": {
          "default": false,
          "title": "Active",
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "detail",
        "active"
      ],
      "title": "SemanticItem",
      "type": "object"
    },
    "SourceEdit": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "content": {
          "maxLength": 50000,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content"
      ],
      "title": "SourceEdit",
      "type": "object"
    },
    "VisualReview": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "legibility": {
          "maximum": 5,
          "minimum": 0,
          "title": "Legibility",
          "type": "integer"
        },
        "visual_explanation": {
          "maximum": 5,
          "minimum": 0,
          "title": "Visual Explanation",
          "type": "integer"
        },
        "timing": {
          "maximum": 5,
          "minimum": 0,
          "title": "Timing",
          "type": "integer"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Issues",
          "type": "array"
        },
        "inspected_frames": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Inspected Frames",
          "type": "array"
        },
        "motion_continuity": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Motion Continuity",
          "type": "integer"
        },
        "semantic_expectations": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Semantic Expectations",
          "type": "array"
        },
        "asset_expectations": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Asset Expectations",
          "type": "array"
        },
        "asset_visibility": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Asset Visibility",
          "type": "integer"
        },
        "semantic_accuracy": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Semantic Accuracy",
          "type": "integer"
        },
        "inspected_motion_frames": {
          "items": {
            "type": "string"
          },
          "maxItems": 96,
          "title": "Inspected Motion Frames",
          "type": "array"
        },
        "content_focus": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Content Focus",
          "type": "integer"
        },
        "cover_promise": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Cover Promise",
          "type": "integer"
        },
        "opening_closing": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Opening Closing",
          "type": "integer"
        },
        "viewer_presentation": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Viewer Presentation",
          "type": "integer"
        },
        "purpose_fulfillment": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Purpose Fulfillment",
          "type": "integer"
        },
        "object_fidelity": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Object Fidelity",
          "type": "integer"
        },
        "causal_motion": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Causal Motion",
          "type": "integer"
        },
        "creation_expectations": {
          "items": {
            "type": "string"
          },
          "maxItems": 1536,
          "title": "Creation Expectations",
          "type": "array"
        },
        "subject_fidelity": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Subject Fidelity",
          "type": "integer"
        },
        "scene_composition": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Scene Composition",
          "type": "integer"
        },
        "creative_motion": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Creative Motion",
          "type": "integer"
        }
      },
      "required": [
        "accepted",
        "legibility",
        "visual_explanation",
        "timing",
        "issues",
        "inspected_frames",
        "motion_continuity",
        "semantic_expectations",
        "asset_expectations",
        "asset_visibility",
        "semantic_accuracy",
        "inspected_motion_frames",
        "content_focus",
        "cover_promise",
        "opening_closing",
        "viewer_presentation",
        "purpose_fulfillment",
        "object_fidelity",
        "causal_motion",
        "creation_expectations",
        "subject_fidelity",
        "scene_composition",
        "creative_motion"
      ],
      "title": "VisualReview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "write_files",
        "build",
        "render_preview",
        "review",
        "finish",
        "request_assets",
        "inspect_asset"
      ],
      "title": "Action",
      "type": "string"
    },
    "summary": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/SourceEdit"
      },
      "maxItems": 30,
      "title": "Files",
      "type": "array"
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/VisualReview"
        },
        {
          "type": "null"
        }
      ]
    },
    "asset_requests": {
      "items": {
        "$ref": "#/$defs/AssetRequirement"
      },
      "maxItems": 8,
      "title": "Asset Requests",
      "type": "array"
    },
    "asset_id": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9_-]{1,60}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asset Id"
    }
  },
  "required": [
    "action",
    "summary",
    "files",
    "review",
    "asset_requests",
    "asset_id"
  ],
  "title": "EngineeringAction",
  "type": "object"
}
