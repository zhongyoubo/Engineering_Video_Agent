{
  "$defs": {
    "SemanticItem": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "detail": {
          "default": "",
          "maxLength": 180,
          "title": "Detail",
          "type": "string"
        },
        "active": {
          "default": false,
          "title": "Active",
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "title": "SemanticItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-zA-Z0-9_-]{1,60}$",
      "title": "Id",
      "type": "string"
    },
    "purpose": {
      "maxLength": 400,
      "minLength": 5,
      "title": "Purpose",
      "type": "string"
    },
    "provider": {
      "default": "component_svg",
      "enum": [
        "component_svg",
        "image_service"
      ],
      "title": "Provider",
      "type": "string"
    },
    "title": {
      "maxLength": 60,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/SemanticItem"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "id",
    "purpose",
    "title",
    "items"
  ],
  "title": "AssetRequirement",
  "type": "object"
}
