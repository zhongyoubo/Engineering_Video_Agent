{
  "$defs": {
    "AgentDesign": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "pattern": "^1\\.0$",
          "title": "Protocol",
          "type": "string"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/DesignedScene"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Scenes",
          "type": "array"
        }
      },
      "required": [
        "protocol",
        "scenes"
      ],
      "title": "AgentDesign",
      "type": "object"
    },
    "DesignedScene": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,60}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SceneType"
        },
        "title": {
          "maxLength": 90,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "subtitle": {
          "maxLength": 160,
          "title": "Subtitle",
          "type": "string"
        },
        "narration": {
          "maxLength": 1600,
          "minLength": 1,
          "title": "Narration",
          "type": "string"
        },
        "bullets": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "Bullets",
          "type": "array"
        },
        "code": {
          "maxLength": 1400,
          "title": "Code",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Claim Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Evidence Ids",
          "type": "array"
        },
        "duration": {
          "maximum": 180,
          "minimum": 2,
          "title": "Duration",
          "type": "number"
        },
        "diagram": {
          "anyOf": [
            {
              "$ref": "#/$defs/Diagram"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "subtitle",
        "narration",
        "bullets",
        "code",
        "claim_ids",
        "evidence_ids",
        "duration",
        "diagram"
      ],
      "title": "DesignedScene",
      "type": "object"
    },
    "Diagram": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/DiagramNode"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/DiagramEdge"
          },
          "maxItems": 24,
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "title": "Diagram",
      "type": "object"
    },
    "DiagramEdge": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "label": {
          "maxLength": 24,
          "title": "Label",
          "type": "string"
        },
        "reveal": {
          "maximum": 0.9,
          "minimum": 0,
          "title": "Reveal",
          "type": "number"
        }
      },
      "required": [
        "source",
        "target",
        "label",
        "reveal"
      ],
      "title": "DiagramEdge",
      "type": "object"
    },
    "DiagramNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "detail": {
          "maxLength": 60,
          "title": "Detail",
          "type": "string"
        },
        "x": {
          "maximum": 1460,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 460,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "reveal": {
          "maximum": 0.9,
          "minimum": 0,
          "title": "Reveal",
          "type": "number"
        },
        "emphasis": {
          "enum": [
            "none",
            "pulse"
          ],
          "title": "Emphasis",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "detail",
        "x",
        "y",
        "reveal",
        "emphasis"
      ],
      "title": "DiagramNode",
      "type": "object"
    },
    "MotionShot": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "visual": {
          "maxLength": 1500,
          "minLength": 10,
          "title": "Visual",
          "type": "string"
        },
        "movement": {
          "maxLength": 1500,
          "minLength": 10,
          "title": "Movement",
          "type": "string"
        },
        "assets": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Assets",
          "type": "array"
        }
      },
      "required": [
        "scene_id",
        "visual",
        "movement",
        "assets"
      ],
      "title": "MotionShot",
      "type": "object"
    },
    "SceneType": {
      "enum": [
        "title",
        "cards",
        "flow",
        "architecture",
        "code",
        "terminal",
        "ui",
        "summary"
      ],
      "title": "SceneType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "objective": {
      "maxLength": 1500,
      "minLength": 10,
      "title": "Objective",
      "type": "string"
    },
    "story_arc": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 2,
      "title": "Story Arc",
      "type": "array"
    },
    "art_direction": {
      "maxLength": 2000,
      "minLength": 10,
      "title": "Art Direction",
      "type": "string"
    },
    "voice_direction": {
      "maxLength": 1000,
      "minLength": 10,
      "title": "Voice Direction",
      "type": "string"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/MotionShot"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Shots",
      "type": "array"
    },
    "storyboard": {
      "$ref": "#/$defs/AgentDesign"
    }
  },
  "required": [
    "objective",
    "story_arc",
    "art_direction",
    "voice_direction",
    "shots",
    "storyboard"
  ],
  "title": "ProductionPlan",
  "type": "object"
}
