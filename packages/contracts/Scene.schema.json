{
  "$defs": {
    "CompiledEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "action": {
          "enum": [
            "reveal",
            "highlight",
            "progress"
          ],
          "title": "Action",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "exclusiveMinimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "timing_source": {
          "enum": [
            "measured_words",
            "estimated_draft"
          ],
          "title": "Timing Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "target",
        "action",
        "start_frame",
        "end_frame",
        "timing_source"
      ],
      "title": "CompiledEvent",
      "type": "object"
    },
    "Cue": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "number"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "text"
      ],
      "title": "Cue",
      "type": "object"
    },
    "CueAnchor": {
      "additionalProperties": false,
      "properties": {
        "phrase": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Phrase",
          "type": "string"
        },
        "occurrence": {
          "default": 1,
          "maximum": 30,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        },
        "edge": {
          "default": "start",
          "enum": [
            "start",
            "end"
          ],
          "title": "Edge",
          "type": "string"
        },
        "offset_ms": {
          "default": 0,
          "maximum": 2000,
          "minimum": -2000,
          "title": "Offset Ms",
          "type": "integer"
        }
      },
      "required": [
        "phrase"
      ],
      "title": "CueAnchor",
      "type": "object"
    },
    "Diagram": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/DiagramNode"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/DiagramEdge"
          },
          "maxItems": 24,
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "title": "Diagram",
      "type": "object"
    },
    "DiagramEdge": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "label": {
          "maxLength": 24,
          "title": "Label",
          "type": "string"
        },
        "reveal": {
          "maximum": 0.9,
          "minimum": 0,
          "title": "Reveal",
          "type": "number"
        }
      },
      "required": [
        "source",
        "target",
        "label",
        "reveal"
      ],
      "title": "DiagramEdge",
      "type": "object"
    },
    "DiagramNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "detail": {
          "maxLength": 60,
          "title": "Detail",
          "type": "string"
        },
        "x": {
          "maximum": 1460,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 460,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "reveal": {
          "maximum": 0.9,
          "minimum": 0,
          "title": "Reveal",
          "type": "number"
        },
        "emphasis": {
          "enum": [
            "none",
            "pulse"
          ],
          "title": "Emphasis",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "detail",
        "x",
        "y",
        "reveal",
        "emphasis"
      ],
      "title": "DiagramNode",
      "type": "object"
    },
    "MotionEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,60}$",
          "title": "Id",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "action": {
          "enum": [
            "reveal",
            "highlight",
            "progress"
          ],
          "title": "Action",
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/CueAnchor"
        },
        "duration_ms": {
          "default": 700,
          "maximum": 5000,
          "minimum": 100,
          "title": "Duration Ms",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "target",
        "action",
        "anchor"
      ],
      "title": "MotionEvent",
      "type": "object"
    },
    "SceneSpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "4.0",
          "default": "4.0",
          "title": "Schema Version",
          "type": "string"
        },
        "purpose": {
          "maxLength": 500,
          "minLength": 5,
          "title": "Purpose",
          "type": "string"
        },
        "chapter": {
          "default": "",
          "maxLength": 100,
          "title": "Chapter",
          "type": "string"
        },
        "pattern": {
          "enum": [
            "overview",
            "code_scan",
            "compare",
            "graph",
            "capacity",
            "queue",
            "depth"
          ],
          "title": "Pattern",
          "type": "string"
        },
        "layout": {
          "default": "grid",
          "enum": [
            "grid",
            "fan"
          ],
          "title": "Layout",
          "type": "string"
        },
        "elements": {
          "items": {
            "$ref": "#/$defs/VisualElement"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Elements",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/MotionEvent"
          },
          "maxItems": 24,
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "purpose",
        "pattern",
        "elements"
      ],
      "title": "SceneSpec",
      "type": "object"
    },
    "SceneType": {
      "enum": [
        "title",
        "cards",
        "flow",
        "architecture",
        "code",
        "terminal",
        "ui",
        "summary"
      ],
      "title": "SceneType",
      "type": "string"
    },
    "ViewerDisclosure": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "start_seconds": {
          "default": 0,
          "maximum": 180,
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "end_seconds": {
          "default": 4,
          "exclusiveMinimum": 0,
          "maximum": 180,
          "title": "End Seconds",
          "type": "number"
        }
      },
      "required": [
        "text"
      ],
      "title": "ViewerDisclosure",
      "type": "object"
    },
    "VisualElement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,60}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "VisualElement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-zA-Z0-9_-]{1,60}$",
      "title": "Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/SceneType"
    },
    "title": {
      "maxLength": 90,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "subtitle": {
      "default": "",
      "maxLength": 320,
      "title": "Subtitle",
      "type": "string"
    },
    "narration": {
      "maxLength": 3200,
      "minLength": 1,
      "title": "Narration",
      "type": "string"
    },
    "bullets": {
      "items": {
        "type": "string"
      },
      "maxItems": 6,
      "title": "Bullets",
      "type": "array"
    },
    "code": {
      "default": "",
      "maxLength": 1400,
      "title": "Code",
      "type": "string"
    },
    "claim_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Claim Ids",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Evidence Ids",
      "type": "array"
    },
    "verification": {
      "default": "concept",
      "enum": [
        "user_provided",
        "static",
        "runtime",
        "concept"
      ],
      "title": "Verification",
      "type": "string"
    },
    "duration": {
      "default": 12,
      "maximum": 180,
      "minimum": 2,
      "title": "Duration",
      "type": "number"
    },
    "start_frame": {
      "default": 0,
      "minimum": 0,
      "title": "Start Frame",
      "type": "integer"
    },
    "frames": {
      "default": 360,
      "minimum": 1,
      "title": "Frames",
      "type": "integer"
    },
    "audio_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Id"
    },
    "media_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Media Id"
    },
    "media_kind": {
      "default": "image",
      "enum": [
        "image",
        "video"
      ],
      "title": "Media Kind",
      "type": "string"
    },
    "cues": {
      "items": {
        "$ref": "#/$defs/Cue"
      },
      "title": "Cues",
      "type": "array"
    },
    "locked": {
      "default": false,
      "title": "Locked",
      "type": "boolean"
    },
    "diagram": {
      "anyOf": [
        {
          "$ref": "#/$defs/Diagram"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "motion": {
      "anyOf": [
        {
          "$ref": "#/$defs/SceneSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "compiled_events": {
      "items": {
        "$ref": "#/$defs/CompiledEvent"
      },
      "maxItems": 24,
      "title": "Compiled Events",
      "type": "array"
    },
    "role": {
      "default": "content",
      "enum": [
        "content",
        "opening",
        "hook",
        "problem",
        "argument",
        "example",
        "mechanism",
        "demonstration",
        "limitation",
        "recommendation",
        "closing"
      ],
      "title": "Role",
      "type": "string"
    },
    "message": {
      "default": "",
      "maxLength": 500,
      "title": "Message",
      "type": "string"
    },
    "viewer_question": {
      "default": "",
      "maxLength": 500,
      "title": "Viewer Question",
      "type": "string"
    },
    "disclosures": {
      "items": {
        "$ref": "#/$defs/ViewerDisclosure"
      },
      "maxItems": 4,
      "title": "Disclosures",
      "type": "array"
    }
  },
  "required": [
    "id",
    "type",
    "title",
    "narration"
  ],
  "title": "Scene",
  "type": "object"
}
