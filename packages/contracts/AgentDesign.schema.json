{
  "$defs": {
    "ContentStrategy": {
      "additionalProperties": false,
      "properties": {
        "taxonomy_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Taxonomy Version",
          "type": "string"
        },
        "intent": {
          "enum": [
            "introduction",
            "explanation",
            "analysis",
            "viewpoint",
            "advice",
            "tutorial"
          ],
          "title": "Intent",
          "type": "string"
        },
        "secondary_intents": {
          "items": {
            "enum": [
              "introduction",
              "explanation",
              "analysis",
              "viewpoint",
              "advice",
              "tutorial"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Secondary Intents",
          "type": "array"
        },
        "subject_kind": {
          "enum": [
            "project",
            "product",
            "technology",
            "knowledge",
            "concept",
            "mechanism",
            "method",
            "workflow",
            "problem",
            "phenomenon"
          ],
          "title": "Subject Kind",
          "type": "string"
        },
        "audience_description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Audience Description",
          "type": "string"
        },
        "audience_level": {
          "enum": [
            "introductory",
            "intermediate",
            "advanced"
          ],
          "title": "Audience Level",
          "type": "string"
        },
        "presentation_forms": {
          "items": {
            "enum": [
              "diagram",
              "case_study",
              "comparison",
              "demonstration",
              "code_walkthrough",
              "data_visualization",
              "story"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Presentation Forms",
          "type": "array"
        },
        "rationale": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "success_criteria": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Success Criteria",
          "type": "array"
        },
        "outline": {
          "items": {
            "$ref": "#/$defs/NarrativeBeat"
          },
          "maxItems": 12,
          "minItems": 2,
          "title": "Outline",
          "type": "array"
        }
      },
      "required": [
        "taxonomy_version",
        "intent",
        "secondary_intents",
        "subject_kind",
        "audience_description",
        "audience_level",
        "presentation_forms",
        "rationale",
        "success_criteria",
        "outline"
      ],
      "title": "ContentStrategy",
      "type": "object"
    },
    "CoverSpec": {
      "additionalProperties": false,
      "properties": {
        "headline": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "subtitle": {
          "default": "",
          "maxLength": 160,
          "title": "Subtitle",
          "type": "string"
        }
      },
      "required": [
        "headline",
        "subtitle"
      ],
      "title": "CoverSpec",
      "type": "object"
    },
    "CueAnchor": {
      "additionalProperties": false,
      "properties": {
        "phrase": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Phrase",
          "type": "string"
        },
        "occurrence": {
          "default": 1,
          "maximum": 30,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        },
        "edge": {
          "default": "start",
          "enum": [
            "start",
            "end"
          ],
          "title": "Edge",
          "type": "string"
        },
        "offset_ms": {
          "default": 0,
          "maximum": 2000,
          "minimum": -2000,
          "title": "Offset Ms",
          "type": "integer"
        }
      },
      "required": [
        "phrase",
        "occurrence",
        "edge",
        "offset_ms"
      ],
      "title": "CueAnchor",
      "type": "object"
    },
    "DesignedScene": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,60}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SceneType"
        },
        "title": {
          "maxLength": 90,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "subtitle": {
          "maxLength": 320,
          "title": "Subtitle",
          "type": "string"
        },
        "narration": {
          "maxLength": 3200,
          "minLength": 1,
          "title": "Narration",
          "type": "string"
        },
        "bullets": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "Bullets",
          "type": "array"
        },
        "code": {
          "maxLength": 1400,
          "title": "Code",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Claim Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Evidence Ids",
          "type": "array"
        },
        "duration": {
          "maximum": 180,
          "minimum": 2,
          "title": "Duration",
          "type": "number"
        },
        "diagram": {
          "anyOf": [
            {
              "$ref": "#/$defs/Diagram"
            },
            {
              "type": "null"
            }
          ]
        },
        "motion": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "default": "content",
          "enum": [
            "content",
            "opening",
            "hook",
            "problem",
            "argument",
            "example",
            "mechanism",
            "demonstration",
            "limitation",
            "recommendation",
            "closing"
          ],
          "title": "Role",
          "type": "string"
        },
        "message": {
          "default": "",
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        },
        "viewer_question": {
          "default": "",
          "maxLength": 500,
          "title": "Viewer Question",
          "type": "string"
        },
        "disclosures": {
          "items": {
            "$ref": "#/$defs/ViewerDisclosure"
          },
          "maxItems": 4,
          "title": "Disclosures",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "subtitle",
        "narration",
        "bullets",
        "code",
        "claim_ids",
        "evidence_ids",
        "duration",
        "diagram",
        "motion",
        "role",
        "message",
        "viewer_question",
        "disclosures"
      ],
      "title": "DesignedScene",
      "type": "object"
    },
    "Diagram": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/DiagramNode"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/DiagramEdge"
          },
          "maxItems": 24,
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "title": "Diagram",
      "type": "object"
    },
    "DiagramEdge": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "label": {
          "maxLength": 24,
          "title": "Label",
          "type": "string"
        },
        "reveal": {
          "maximum": 0.9,
          "minimum": 0,
          "title": "Reveal",
          "type": "number"
        }
      },
      "required": [
        "source",
        "target",
        "label",
        "reveal"
      ],
      "title": "DiagramEdge",
      "type": "object"
    },
    "DiagramNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "detail": {
          "maxLength": 60,
          "title": "Detail",
          "type": "string"
        },
        "x": {
          "maximum": 1460,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 460,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "reveal": {
          "maximum": 0.9,
          "minimum": 0,
          "title": "Reveal",
          "type": "number"
        },
        "emphasis": {
          "enum": [
            "none",
            "pulse"
          ],
          "title": "Emphasis",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "detail",
        "x",
        "y",
        "reveal",
        "emphasis"
      ],
      "title": "DiagramNode",
      "type": "object"
    },
    "EditorialPlan": {
      "additionalProperties": false,
      "properties": {
        "audience_question": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Audience Question",
          "type": "string"
        },
        "core_message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Core Message",
          "type": "string"
        },
        "viewer_takeaway": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Viewer Takeaway",
          "type": "string"
        },
        "hook": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Hook",
          "type": "string"
        },
        "supports": {
          "items": {
            "$ref": "#/$defs/SupportPoint"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Supports",
          "type": "array"
        },
        "closing": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Closing",
          "type": "string"
        },
        "cover": {
          "$ref": "#/$defs/CoverSpec"
        },
        "strategy": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentStrategy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "audience_question",
        "core_message",
        "viewer_takeaway",
        "hook",
        "supports",
        "closing",
        "cover",
        "strategy"
      ],
      "title": "EditorialPlan",
      "type": "object"
    },
    "MotionEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,60}$",
          "title": "Id",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "action": {
          "enum": [
            "reveal",
            "highlight",
            "progress"
          ],
          "title": "Action",
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/CueAnchor"
        },
        "duration_ms": {
          "default": 700,
          "maximum": 5000,
          "minimum": 100,
          "title": "Duration Ms",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "target",
        "action",
        "anchor",
        "duration_ms"
      ],
      "title": "MotionEvent",
      "type": "object"
    },
    "NarrativeBeat": {
      "additionalProperties": false,
      "properties": {
        "function": {
          "enum": [
            "orientation",
            "definition",
            "mechanism",
            "evidence",
            "comparison",
            "counterargument",
            "limitations",
            "decision",
            "steps",
            "example",
            "application",
            "check",
            "conclusion"
          ],
          "title": "Function",
          "type": "string"
        },
        "purpose": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "scene_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Scene Ids",
          "type": "array"
        }
      },
      "required": [
        "function",
        "purpose",
        "scene_ids"
      ],
      "title": "NarrativeBeat",
      "type": "object"
    },
    "SceneSpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "4.0",
          "default": "4.0",
          "title": "Schema Version",
          "type": "string"
        },
        "purpose": {
          "maxLength": 500,
          "minLength": 5,
          "title": "Purpose",
          "type": "string"
        },
        "chapter": {
          "default": "",
          "maxLength": 100,
          "title": "Chapter",
          "type": "string"
        },
        "pattern": {
          "enum": [
            "overview",
            "code_scan",
            "compare",
            "graph",
            "capacity",
            "queue",
            "depth"
          ],
          "title": "Pattern",
          "type": "string"
        },
        "layout": {
          "default": "grid",
          "enum": [
            "grid",
            "fan"
          ],
          "title": "Layout",
          "type": "string"
        },
        "elements": {
          "items": {
            "$ref": "#/$defs/VisualElement"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Elements",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/MotionEvent"
          },
          "maxItems": 24,
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "purpose",
        "chapter",
        "pattern",
        "layout",
        "elements",
        "events"
      ],
      "title": "SceneSpec",
      "type": "object"
    },
    "SceneType": {
      "enum": [
        "title",
        "cards",
        "flow",
        "architecture",
        "code",
        "terminal",
        "ui",
        "summary"
      ],
      "title": "SceneType",
      "type": "string"
    },
    "SupportPoint": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Claim Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "message",
        "claim_ids",
        "evidence_ids"
      ],
      "title": "SupportPoint",
      "type": "object"
    },
    "ViewerDisclosure": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "start_seconds": {
          "default": 0,
          "maximum": 180,
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "end_seconds": {
          "default": 4,
          "exclusiveMinimum": 0,
          "maximum": 180,
          "title": "End Seconds",
          "type": "number"
        }
      },
      "required": [
        "text",
        "start_seconds",
        "end_seconds"
      ],
      "title": "ViewerDisclosure",
      "type": "object"
    },
    "VisualElement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,60}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "VisualElement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "pattern": "^1\\.0$",
      "title": "Protocol",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/DesignedScene"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "editorial": {
      "anyOf": [
        {
          "$ref": "#/$defs/EditorialPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "protocol",
    "scenes",
    "editorial"
  ],
  "title": "AgentDesign",
  "type": "object"
}
