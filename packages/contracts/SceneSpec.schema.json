{
  "$defs": {
    "CodeFocus": {
      "additionalProperties": false,
      "properties": {
        "element_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,60}$",
          "title": "Element Id",
          "type": "string"
        },
        "line": {
          "maximum": 1401,
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "end_line": {
          "anyOf": [
            {
              "maximum": 1401,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        }
      },
      "required": [
        "element_id",
        "line"
      ],
      "title": "CodeFocus",
      "type": "object"
    },
    "CueAnchor": {
      "additionalProperties": false,
      "properties": {
        "phrase": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Phrase",
          "type": "string"
        },
        "occurrence": {
          "default": 1,
          "maximum": 30,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        },
        "edge": {
          "default": "start",
          "enum": [
            "start",
            "end"
          ],
          "title": "Edge",
          "type": "string"
        },
        "offset_ms": {
          "default": 0,
          "maximum": 2000,
          "minimum": -2000,
          "title": "Offset Ms",
          "type": "integer"
        }
      },
      "required": [
        "phrase"
      ],
      "title": "CueAnchor",
      "type": "object"
    },
    "MotionEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,60}$",
          "title": "Id",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "action": {
          "enum": [
            "reveal",
            "highlight",
            "progress"
          ],
          "title": "Action",
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/CueAnchor"
        },
        "duration_ms": {
          "default": 700,
          "maximum": 5000,
          "minimum": 100,
          "title": "Duration Ms",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "target",
        "action",
        "anchor"
      ],
      "title": "MotionEvent",
      "type": "object"
    },
    "VisualElement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,60}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "VisualElement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "4.0",
      "default": "4.0",
      "title": "Schema Version",
      "type": "string"
    },
    "purpose": {
      "maxLength": 500,
      "minLength": 5,
      "title": "Purpose",
      "type": "string"
    },
    "chapter": {
      "default": "",
      "maxLength": 100,
      "title": "Chapter",
      "type": "string"
    },
    "pattern": {
      "enum": [
        "overview",
        "code_scan",
        "compare",
        "graph",
        "capacity",
        "queue",
        "depth"
      ],
      "title": "Pattern",
      "type": "string"
    },
    "layout": {
      "default": "grid",
      "enum": [
        "grid",
        "fan"
      ],
      "title": "Layout",
      "type": "string"
    },
    "elements": {
      "items": {
        "$ref": "#/$defs/VisualElement"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Elements",
      "type": "array"
    },
    "code_focus": {
      "items": {
        "$ref": "#/$defs/CodeFocus"
      },
      "maxItems": 4,
      "title": "Code Focus",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/MotionEvent"
      },
      "maxItems": 24,
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "purpose",
    "pattern",
    "elements"
  ],
  "title": "SceneSpec",
  "type": "object"
}
