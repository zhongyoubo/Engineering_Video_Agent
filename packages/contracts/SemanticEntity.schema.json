{
  "$defs": {
    "SemanticItem": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "detail": {
          "default": "",
          "maxLength": 180,
          "title": "Detail",
          "type": "string"
        },
        "active": {
          "default": false,
          "title": "Active",
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "title": "SemanticItem",
      "type": "object"
    },
    "SpatialSpec": {
      "additionalProperties": false,
      "properties": {
        "seed": {
          "default": 17,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "count": {
          "default": 240,
          "maximum": 768,
          "minimum": 12,
          "title": "Count",
          "type": "integer"
        },
        "columns": {
          "default": 20,
          "maximum": 32,
          "minimum": 4,
          "title": "Columns",
          "type": "integer"
        },
        "camera_radius": {
          "default": 34,
          "maximum": 90,
          "minimum": 12,
          "title": "Camera Radius",
          "type": "number"
        },
        "camera_height": {
          "default": 18,
          "maximum": 50,
          "minimum": 5,
          "title": "Camera Height",
          "type": "number"
        },
        "orbit_degrees": {
          "default": 36,
          "maximum": 90,
          "minimum": -90,
          "title": "Orbit Degrees",
          "type": "number"
        },
        "source_node": {
          "default": 0,
          "maximum": 63,
          "minimum": 0,
          "title": "Source Node",
          "type": "integer"
        },
        "effect_parameter_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_-]{1,60}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Parameter Id"
        },
        "asset_keys": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Asset Keys",
          "type": "array"
        }
      },
      "title": "SpatialSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-zA-Z0-9_-]{1,60}$",
      "title": "Id",
      "type": "string"
    },
    "component": {
      "enum": [
        "PromptInput",
        "Conversation",
        "TokenSequence",
        "ContextWindow",
        "DocumentChunks",
        "RetrievalResults",
        "ModelBoundary",
        "ToolCall",
        "TaskState",
        "EvidenceStack",
        "ApprovalGate",
        "CodeWorkspace",
        "AssetImage",
        "Dial",
        "BranchTree",
        "MetricBar",
        "FlowReservoir",
        "QueueFlow",
        "SpatialCity",
        "QuantityMatrix",
        "NodeNetwork"
      ],
      "title": "Component",
      "type": "string"
    },
    "title": {
      "maxLength": 60,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "text": {
      "default": "",
      "maxLength": 600,
      "title": "Text",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/SemanticItem"
      },
      "maxItems": 12,
      "title": "Items",
      "type": "array"
    },
    "state": {
      "default": "pending",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "awaiting_confirmation",
        "rejected",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    },
    "x": {
      "default": 0,
      "maximum": 1520,
      "minimum": 0,
      "title": "X",
      "type": "number"
    },
    "y": {
      "default": 0,
      "maximum": 530,
      "minimum": 0,
      "title": "Y",
      "type": "number"
    },
    "width": {
      "default": 520,
      "maximum": 1920,
      "minimum": 180,
      "title": "Width",
      "type": "number"
    },
    "height": {
      "default": 400,
      "maximum": 1080,
      "minimum": 120,
      "title": "Height",
      "type": "number"
    },
    "bind_to": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9_-]{1,60}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bind To"
    },
    "asset_key": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9_-]{1,60}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asset Key"
    },
    "image_style": {
      "default": "panel",
      "enum": [
        "panel",
        "artwork"
