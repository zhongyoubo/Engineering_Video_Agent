      "title": "Image Style",
      "type": "string"
    },
    "image_fit": {
      "default": "contain",
      "enum": [
        "contain",
        "cover"
      ],
      "title": "Image Fit",
      "type": "string"
    },
    "opacity": {
      "default": 1,
      "maximum": 1,
      "minimum": 0,
      "title": "Opacity",
      "type": "number"
    },
    "scale": {
      "default": 1,
      "maximum": 3,
      "minimum": 0.2,
      "title": "Scale",
      "type": "number"
    },
    "rotation": {
      "default": 0,
      "maximum": 180,
      "minimum": -180,
      "title": "Rotation",
      "type": "number"
    },
    "parameter_id": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9_-]{1,60}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parameter Id"
    },
    "inflow_id": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9_-]{1,60}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inflow Id"
    },
    "outflow_id": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9_-]{1,60}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outflow Id"
    },
    "capacity": {
      "default": 100,
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "title": "Capacity",
      "type": "number"
    },
    "spatial": {
      "anyOf": [
        {
          "$ref": "#/$defs/SpatialSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "immersive": {
      "default": false,
      "title": "Immersive",
      "type": "boolean"
    },
    "provenance": {
      "default": "illustrative",
      "enum": [
        "illustrative",
        "observed"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "title": "Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "id",
    "component",
    "title"
  ],
  "title": "SemanticEntity",
  "type": "object"
}
