{
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-zA-Z0-9_-]{1,60}$",
      "title": "Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "subject",
        "environment",
        "prop",
        "annotation",
        "camera"
      ],
      "title": "Role",
      "type": "string"
    },
    "description": {
      "maxLength": 800,
      "minLength": 10,
      "title": "Description",
      "type": "string"
    },
    "implementation": {
      "enum": [
        "source",
        "asset",
        "capture",
        "kit"
      ],
      "title": "Implementation",
      "type": "string"
    },
    "source_file": {
      "anyOf": [
        {
          "maxLength": 240,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source File"
    },
    "asset_key": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9_-]{1,60}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asset Key"
    },
    "library_ref": {
      "anyOf": [
        {
          "maxLength": 120,
          "pattern": "^library:pack\\.[a-z0-9_.-]+@[a-zA-Z0-9_.-]{1,20}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Library Ref"
    }
  },
  "required": [
    "id",
    "role",
    "description",
    "implementation"
  ],
  "title": "CreativeElement",
  "type": "object"
}
