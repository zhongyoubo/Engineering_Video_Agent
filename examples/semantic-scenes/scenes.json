  "scenes": [
    {
      "id": "agent",
      "type": "ui",
      "role": "opening",
      "title": "Agent：目标、工具与确认",
      "narration": "提出目标，查询问题，等待确认，确认完成。",
      "duration": 8,
      "frames": 240,
      "visual_scene": {
        "purpose": "把目标和确认界面绑定到真实设备屏幕",
        "setting": "studio",
        "objects": [
          {
            "id": "laptop",
            "kind": "laptop",
            "label": "目标输入",
            "x": 30,
            "y": 120,
            "width": 620,
            "height": 380,
            "screen": "black"
          },
          {
            "id": "phone",
            "kind": "phone",
            "label": "操作确认",
            "x": 1420,
            "y": 40,
            "width": 200,
            "height": 460,
            "screen": "black"
          }
        ]
      },
      "semantic_scene": {
        "viewer_question": "工具结果怎样影响下一步？",
        "entities": [
          {
            "id": "goal",
            "component": "PromptInput",
            "title": "项目交付分析",
            "x": 0,
            "y": 0,
            "width": 520,
            "height": 400,
            "bind_to": "laptop",
            "text": "判断项目能否按期交付",
            "items": [
              {
                "text": "范围：当前项目"
              }
            ]
          },
          {
            "id": "query",
            "component": "ToolCall",
            "title": "查询当前问题",
            "x": 730,
            "y": 100,
            "width": 560,
            "height": 420,
            "items": [
              {
                "text": "search_issues",
                "detail": "当前项目 / 未关闭"
              }
            ]
          },
          {
            "id": "approval",
            "component": "ApprovalGate",
            "title": "发送风险通知",
            "x": 0,
            "y": 0,
            "width": 520,
            "height": 400,
            "state": "awaiting_confirmation",
            "bind_to": "phone",
            "text": "拟发送给项目负责人",
            "items": [
              {
                "text": "发送前由人确认"
              }
            ]
          }
        ],
        "events": [
          {
            "id": "submit",
            "target": "goal",
            "action": "transition",
            "anchor": {
              "phrase": "提出目标"
            },
            "duration_ms": 350,
            "from_state": "pending",
            "to_state": "running"
          },
          {
            "id": "query",
            "target": "query",
            "action": "transition",
            "anchor": {
              "phrase": "查询问题"
            },
            "duration_ms": 350,
            "from_state": "pending",
            "to_state": "running"
          },
          {
            "id": "return",
            "target": "query",
            "action": "transition",
            "anchor": {
              "phrase": "等待确认"
            },
            "duration_ms": 350,
            "from_state": "running",
            "to_state": "succeeded",
            "depends_on": [
              "query"
            ],
            "items": [
              {
                "text": "search_issues",
                "detail": "请求已完成"
              },
              {
                "text": "接口契约未冻结",
                "detail": "影响集成"
              },
              {
                "text": "回归测试失败",
                "detail": "恢复时间待查"
              }
            ]
          },
          {
            "id": "confirm",
            "target": "approval",
            "action": "transition",
            "anchor": {
              "phrase": "确认完成"
            },
            "duration_ms": 350,
            "from_state": "awaiting_confirmation",
            "to_state": "succeeded"
          }
        ],
        "expectations": [
          {
            "id": "goal_started",
            "event_id": "submit",
            "visible_result": "目标从待执行变为执行中"
          },
          {
            "id": "tool_started",
            "event_id": "query",
            "visible_result": "工具请求显示执行中"
          },
          {
            "id": "tool_result",
            "event_id": "return",
            "visible_result": "结果区域显示两项具体问题"
          },
          {
            "id": "confirmed",
            "event_id": "confirm",
            "visible_result": "手机按钮和标注均显示已完成"
          }
        ]
      }
    },
    {
      "id": "rag",
