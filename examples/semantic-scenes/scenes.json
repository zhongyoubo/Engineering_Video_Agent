            "height": 540,
            "state": "succeeded",
            "asset_key": "knowledge"
          },
          {
            "id": "retrieved",
            "component": "RetrievalResults",
            "title": "检索候选",
            "x": 575,
            "y": 40,
            "width": 520,
            "height": 540,
            "items": [
              {
                "text": "交付检查清单",
                "detail": "文档第 2 节"
              },
              {
                "text": "接口约定说明",
                "detail": "文档第 3 节"
              },
              {
                "text": "界面规范",
                "detail": "与问题相关度低"
              }
            ]
          },
          {
            "id": "answer",
            "component": "Conversation",
            "title": "回答与引用",
            "x": 1150,
            "y": 40,
            "width": 540,
            "height": 540,
            "items": [
              {
                "text": "怎样判断项目的交付风险？",
                "detail": "用户问题"
              }
            ]
          }
        ],
        "events": [
          {
            "id": "selected",
            "target": "retrieved",
            "action": "select",
            "anchor": {
              "phrase": "选取片段"
            },
            "duration_ms": 350,
            "selected": 0
          },
          {
            "id": "answered",
            "target": "answer",
            "action": "append",
            "anchor": {
              "phrase": "形成回答"
            },
            "duration_ms": 350,
            "items": [
              {
                "text": "先核对阻塞与恢复计划。",
                "detail": "依据：交付检查清单，第 2 节"
              }
            ],
            "depends_on": [
              "selected"
            ]
          }
        ],
        "expectations": [
          {
            "id": "selection",
            "event_id": "selected",
            "visible_result": "第一条检索片段被明确选中"
          },
          {
            "id": "citation",
            "event_id": "answered",
            "visible_result": "回答出现且带有对应文档引用"
          }
        ]
      }
