# Copy to .env. Empty token generates a local private .data/access-token.
# For Docker set a unique token of at least 24 characters before starting.
EXPLAINER_API_TOKEN=
EXPLAINER_DATA_DIR=.data
EXPLAINER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
EXPLAINER_COOKIE_SECURE=false
EXPLAINER_SCHEDULER=local
EXPLAINER_TENANT_KEYS={}

# Administrator-controlled chat-completions endpoint. No external calls by default.
EXPLAINER_ALLOW_EXTERNAL_MODEL=false
EXPLAINER_MODEL_URL=
EXPLAINER_MODEL_NAME=
EXPLAINER_MODEL_KEY=

# auto -> eSpeak when installed, otherwise clearly labelled subtitle-only output.
EXPLAINER_TTS_ENGINE=auto
EXPLAINER_TTS_URL=http://127.0.0.1:7861
EXPLAINER_TTS_KEY=
# Optional Edge read-aloud: pip install -e 'apps/api[edge]'; choose Edge explicitly.
EXPLAINER_EDGE_VOICE=zh-CN-YunxiNeural
EXPLAINER_TTS_PROXY=
EXPLAINER_RENDER_CONCURRENCY=2
EXPLAINER_RENDER_TIMEOUT=1200
EXPLAINER_CHROME_EXECUTABLE=

# Separate, opt-in source execution. API container never mounts a Docker socket.
EXPLAINER_ENABLE_SANDBOX=false
EXPLAINER_SANDBOX_IMAGE=explainer-sandbox:1.0.0
EXPLAINER_SANDBOX_RUNTIME=runsc
EXPLAINER_SANDBOX_TIMEOUT=90

EXPLAINER_TEMPORAL_ADDRESS=localhost:7233
EXPLAINER_TEMPORAL_NAMESPACE=default
EXPLAINER_TEMPORAL_QUEUE=explainer


EXPLAINER_TTS_REVISION=1

# Shared metadata / object storage (local remains the default)
EXPLAINER_DATABASE_URL=
EXPLAINER_STORAGE_BACKEND=local
EXPLAINER_S3_ENDPOINT=
EXPLAINER_S3_BUCKET=explainer
EXPLAINER_S3_REGION=us-east-1
EXPLAINER_S3_ACCESS_KEY=
EXPLAINER_S3_SECRET_KEY=
# Real known-transcript word alignment; install separate speech environment first.
EXPLAINER_ALIGNMENT_ENGINE=estimated
EXPLAINER_ALIGNMENT_PYTHON=
EXPLAINER_ALIGNMENT_MODEL=
EXPLAINER_ALIGNMENT_DEVICE=cpu
EXPLAINER_ALIGNMENT_TIMEOUT=300
EXPLAINER_GIT_ALLOWED_HOSTS=github.com,gitlab.com

# Native Agent engines (optional). Configure these ONLY on a dedicated Worker.
# API uses no provider credentials. Empty providers keeps the feature disabled.
EXPLAINER_NATIVE_AGENT_PROVIDERS=
EXPLAINER_CODEX_API_KEY=
EXPLAINER_CLAUDE_API_KEY=
# Optional Anthropic-compatible endpoint for the containerized claude CLI (e.g. dedicated gateway).
EXPLAINER_CLAUDE_BASE_URL=
EXPLAINER_CODEX_AGENT_IMAGE=explainer-native-codex:3.0.0
EXPLAINER_CLAUDE_AGENT_IMAGE=explainer-native-claude:3.0.0
EXPLAINER_CODEX_AGENT_MODEL=
EXPLAINER_CLAUDE_AGENT_MODEL=
EXPLAINER_NATIVE_AGENT_RUNTIME=runsc
EXPLAINER_NATIVE_AGENT_NETWORK=bridge
EXPLAINER_NATIVE_AGENT_TIMEOUT=600
EXPLAINER_NATIVE_AGENT_MAX_TURNS=16
EXPLAINER_NATIVE_AGENT_BUDGET_USD=2.0
EXPLAINER_NATIVE_AGENT_REPAIRS=1

# Engineering code execution (separate offline image, no model credentials)
EXPLAINER_ENGINEERING_RENDER_IMAGE=explainer-engineering-render:3.0.0
EXPLAINER_ENGINEERING_MAX_STEPS=18
EXPLAINER_ENGINEERING_TOOL_TIMEOUT=300

# Ming speech service, explicitly selected; no automatic provider fallback.
# Match the exact model ID registered by the deployed SGLang-Omni service.
EXPLAINER_MING_URL=
EXPLAINER_MING_KEY=
EXPLAINER_MING_MODEL=inclusionAI/Ming-3.0-tts-0.5b
# Server-side audio path or supported data URL; only use an approved reference.
# Configure both fields; update TTS_REVISION if the remote reference file changes.
EXPLAINER_MING_REF_AUDIO=
EXPLAINER_MING_REF_TEXT=
EXPLAINER_MING_SEED=123

# Optional administrator-controlled eva-image-1 gateway, used by the trusted Worker.
# This is NOT a vendor-specific endpoint; deploy a gateway implementing the documented contract.
# Empty config disables image_service without substituting another provider.
EXPLAINER_IMAGE_SERVICE_URL=
EXPLAINER_IMAGE_SERVICE_KEY=
EXPLAINER_IMAGE_SERVICE_MODEL=
EXPLAINER_IMAGE_SERVICE_REVISION=1
EXPLAINER_IMAGE_SERVICE_TIMEOUT=180
